# Copy to .env.local and fill in. Never commit .env.local.

# Public (sent to the browser). Supabase dashboard -> Project Settings -> API Keys.
# Use the *publishable* key (sb_publishable_...), never the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Used from Phase 3 (AI chat).
OPENAI_API_KEY=

# Only for `npm run test:db`. Supabase dashboard -> Connect -> Session pooler URI.
# Contains the database password; keep it local.
SUPABASE_DB_URL=
