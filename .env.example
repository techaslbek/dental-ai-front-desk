# Copy to .env.local and fill in. Never commit .env.local.

# Public (sent to the browser). Supabase dashboard -> Project Settings -> API Keys.
# Use the *publishable* key (sb_publishable_...), never the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only (AI chat). Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional; defaults to gpt-5.4-mini.
OPENAI_MODEL=
# Supabase dashboard -> Project Settings -> API Keys -> Secret keys (sb_secret_...).
# The chat writes for anonymous patients, who have no database access themselves.
SUPABASE_SECRET_KEY=

# Only for `npm run test:db`. Supabase dashboard -> Connect -> Session pooler URI.
# Contains the database password; keep it local.
SUPABASE_DB_URL=
